# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# Required (min 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Local stack from docker-compose.yml (values below are for running the API on your host)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_rag
REDIS_URL=redis://localhost:6379/0

# Logging: LOG_LEVEL=DEBUG for more detail; LOG_FORMAT=json for log tools (Loki/Grafana)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional overrides (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# SESSION_IDLE_MINUTES=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300

# LLM — Ollama runs natively on the Mac (Docker on macOS has no GPU/Metal access)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# GOOGLE_API_KEY=
# GROQ_API_KEY=
